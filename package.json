{
  "name": "vocalearn",
  "version": "1.0.0",
  "private": true,
  "description": "高中 7000 單字英文學習 Web App — Next.js + Tailwind on Cloudflare Pages + D1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "seed:gen": "node scripts/csv-to-utf8.mjs",
    "seed:ceec": "node scripts/build-ceec-words.mjs",
    "words:traditional": "python scripts/convert-traditional.py",
    "db:migrate:local": "wrangler d1 execute vocalearn-db --local --file=./migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute vocalearn-db --local --file=./data/seed-words.sql",
    "db:migrate:remote": "wrangler d1 execute vocalearn-db --remote --file=./migrations/0001_init.sql",
    "db:migrate:ceec:remote": "wrangler d1 execute vocalearn-db --remote --file=./migrations/0002_ceec_metadata.sql",
    "db:migrate:auth:remote": "wrangler d1 execute vocalearn-db --remote --file=./migrations/0003_auth_leaderboard.sql",
    "db:seed:remote": "wrangler d1 execute vocalearn-db --remote --file=./data/seed-words.sql",
    "preview": "npm run build && wrangler pages dev out --compatibility-date=2024-09-23 --d1=DB=vocalearn-db",
    "deploy": "npm run build && wrangler pages deploy out"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "wrangler": "^4.131.0"
  }
}
